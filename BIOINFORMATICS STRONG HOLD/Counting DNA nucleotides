# The basic unit of life, cell has a nucleus containing chromatin that condenses into chromosomes during cell division.
# Chromatin contains DNA, a nucleic acid, which is made up of base sequence (A, T, G, C), which stores genetic information.


# Problem 1
# given a DNA string s with at most 100 nt.
# return four integers separated by spaces counting the respective number of times the symbols 'A', 'T', 'G', 'C' occurs. 

#sample problem 
dna1 = 'AGCTTTTCATTCTGACTGCAACGGGCAATATGTCTCTGTGTGGATTAAAAAAAGAGTGTCTGATAGCAGC'
from collections import Counter 
frequency1 = Counter(dna1)

# using letter and count helps unpack the values from variables
for letter, count in frequency1.items():
    print(letter,count)


