#GC content in DNA plays a great role in renaturation rate

data = input('enter FASTA format data')
lines = data.strip().splitlines()

#this remove any blank spaces

#we will create a dictionary and employ simple key and value concepts 

dna_dictionary = {}
current_id = ''

for line in lines:
    if line.startswith('>'):
        current_id = line[1:]
        dna_dictionary[current_id] = []
        
    else:
        dna_dictionary[current_id]+= line
        
        
highest_gc_content = 0
best_id = ''

for seq_id in dna_dictionary:
    dna_seq = dna_dictionary[seq_id]
    
    gc_count = dna_seq.count('G') + dna_seq.count('C')
    gc_percentage = (gc_count/len(dna_seq))*100
    
    if gc_percentage > highest_gc_content:
        highest_gc_content = gc_percentage
        best_id = seq_id
 
print(best_id)       
print(highest_gc_content)
    
    
    
